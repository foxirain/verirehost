{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/verirehost/state-space-scenario.schema.json",
  "title": "VeriRehost state-space scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "initial_atoms", "transitions", "goals"],
  "properties": {
    "schema": {"const": "verirehost/state-space-scenario/v1"},
    "id": {"$ref": "#/$defs/name"},
    "initial_atoms": {"$ref": "#/$defs/atoms"},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/transition"}
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/predicate"}
    },
    "forbidden": {
      "type": "array",
      "items": {"$ref": "#/$defs/predicate"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "max_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "max_states": {"type": "integer", "minimum": 1, "maximum": 100000}
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
    },
    "atoms": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "requires": {"$ref": "#/$defs/atoms"},
        "forbids": {"$ref": "#/$defs/atoms"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "anyOf": [
        {"required": ["adds"], "properties": {"adds": {"minItems": 1}}},
        {"required": ["removes"], "properties": {"removes": {"minItems": 1}}}
      ],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "requires": {"$ref": "#/$defs/atoms"},
        "forbids": {"$ref": "#/$defs/atoms"},
        "adds": {"$ref": "#/$defs/atoms"},
        "removes": {"$ref": "#/$defs/atoms"}
      }
    }
  }
}
